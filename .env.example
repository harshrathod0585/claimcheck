# Copy to .env. Only needed for a FRESH run — replaying the committed sample run
# uses no key and makes no network calls.
#
# Open-weight models only, over any OpenAI-compatible endpoint. No OpenAI.

# Groq — used for the recorded demo; fast enough that time-to-first-verdict is visible.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-235b-a22b-2507

# OpenRouter — used during development, for free model swapping.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3-235b-a22b-instruct

# Local Ollama — same interface, no key required.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:32b

LLM_API_KEY=
